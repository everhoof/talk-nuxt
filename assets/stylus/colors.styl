.page
	--gray_20 #FAFAFA
	--gray_40 #F4F4F4
	--gray_50 #F0F0F0
	--gray_100 #E2E2E2
	--gray_200 #C6C6C6
	--gray_300 #AFAFAF
	--gray_400 #959595
	--gray_500 #7A7A7A
	--gray_600 #606060
	--gray_700 #454545
	--gray_800 #2F2F2F
	--gray_850 #202020
	--gray_900 #1A1A1A
	--gray_950 #0A0A0A

	--green_100 #9591dd
	--green_200 #8883d2
	--green_300 #817bc8
	--green_400 #706bbc
	--green_500 #645fac
	--green_600 #423e92

	--orange_300 #f0ae62
	--orange_400 #e89b48
	--orange_500 #d88a36
	--orange_600 #b9691c
	--orange_700 #a15a14

	--text-error #C0392B
	--text-on-primary-background var(--text-primary)
	--text-control-hover var(--text-primary)
	--text-separator var(--text-secondary)
	--text-menu-hover var(--gray_20)

	--background-control-hover var(--background-hover)
	--background-selection var(--background-input)
	--background-menu-hover var(--primary-dark)

	--border-control-hover var(--primary)
	--border-poll var(--border-input)
	--border-poll-width 1px

	--focus-ring var(--primary)
	--icon-checkmark #ffffff

	&_theme
		&_light
			--primary var(--green_300)
			--primary-dark var(--green_500)
			--primary-light var(--green_200)

			--text-primary var(--gray_950)
			--text-secondary var(--gray_700)
			--text-accent var(--green_300)
			--text-contrast var(--gray_100)

			--background-primary var(--gray_20)
			--background-secondary var(--gray_100)
			--background-accent var(--green_600)
			--background-contrast var(--gray_950)
			--background-input var(--gray_50)
			--background-hover var(--gray_50)
			--background-active var(--gray_20)

			--border-input var(--gray_50)

			--scrollbar-thumb var(--gray_100)
			--scrollbar-track var(--gray_50)

			--shadow rgba(150, 150, 150, .14)

		&_dark
			--primary var(--green_400)
			--primary-dark var(--green_500)
			--primary-light var(--green_200)

			--text-primary var(--gray_100)
			--text-secondary var(--gray_300)
			--text-accent var(--green_200)
			--text-contrast var(--gray_950)

			--background-primary #201e2f
			--background-secondary #2f2e40
			--background-accent #333333
			--background-contrast var(--gray_100)
			--background-input rgba(255, 255, 255, .04)
			--background-select rgba(255, 255, 255, .08)
			--background-hover rgba(255, 255, 255, .05)
			--background-active rgba(255, 255, 255, .1)

			--border-select rgba(255, 255, 255, .08)
			--border-input var(--gray_800)

			--scrollbar-thumb #121212
			--scrollbar-track #1a1a1a

			--shadow rgba(0, 0, 0, .14)

		&_nightmare-night
			--primary var(--orange_400)
			--primary-light var(--orange_300)
			--primary-dark var(--orange_500)

			--text-accent var(--primary)
			--text-on-primary-background #34273a
			--text-control-hover var(--primary)
			--text-separator var(--primary)
			--text-menu-hover var(--primary)

			--background-control-hover rgba(232, 155, 72, .12)
			--background-selection rgba(232, 155, 72, .08)
			--background-menu-hover var(--background-control-hover)

			--border-poll var(--primary)
			--border-poll-width 3px

			--icon-checkmark var(--text-on-primary-background)

			&.page_theme_light
				--primary var(--orange_600)
				--primary-light var(--orange_500)
				--primary-dark var(--orange_700)

				--text-on-primary-background #fffaf2

				--background-control-hover rgba(185, 105, 28, .1)
				--background-selection rgba(185, 105, 28, .07)
