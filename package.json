{
  "name": "@everhoof/im_everhoof",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Everhoof Instant Messaging System",
  "repository": "git@github.com:everhoof/im_everhoof.git",
  "author": {
    "name": "Svyatoslav Fyodorov",
    "email": "intelrug@gmail.com",
    "url": "https://github.com/intelrug"
  },
  "keywords": [
    "everhoof",
    "im",
    "messenger"
  ],
  "scripts": {
    "generate:favicons": "node scripts/generate-favicons.cjs",
    "dev": "pnpm run generate:favicons && nuxt dev --dotenv .env --dotenv .env.local --dotenv .env.development --dotenv .env.development.local",
    "dev:public": "pnpm run generate:favicons && nuxt dev --public --dotenv .env --dotenv .env.local --dotenv .env.development --dotenv .env.development.local",
    "build": "pnpm run generate:favicons && nuxt build",
    "generate": "pnpm run generate:favicons && nuxt generate",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "lint": "pnpm run lint:scripts && pnpm run lint:styles && pnpm run lint:knip",
    "format": "pnpm run format:scripts && pnpm run format:styles",
    "format:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input --fix",
    "typegen": "graphql-codegen",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "nuxt preview",
    "prepare": "pnpm run hooks:install",
    "knip": "knip",
    "lint:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input",
    "lint:scripts": "eslint . --cache",
    "format:scripts": "eslint . --cache --fix",
    "hooks:install": "pnpm exec simple-git-hooks",
    "lint:knip": "knip"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@formatjs/intl-datetimeformat": "^6.18.2",
    "@formatjs/intl-getcanonicallocales": "^2.5.6",
    "@formatjs/intl-locale": "^4.2.13",
    "@formatjs/intl-numberformat": "^8.15.6",
    "@formatjs/intl-pluralrules": "^5.4.6",
    "@pinia/nuxt": "^1.0.3",
    "@rhapsodic/bem-classnames-vue": "^2.1.0",
    "@tanstack/vue-virtual": "^3.13.47",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-bold": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-italic": "^3.33.1",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-strike": "^3.33.1",
    "@tiptap/extension-text": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "@tiptap/vue-3": "^3.33.1",
    "@wessberg/pointer-events": "^1.0.9",
    "abort-controller": "^3.0.0",
    "accesscontrol": "^2.2.1",
    "axios": "^1.21.1",
    "event-target-shim": "^5.0.1",
    "focus-visible": "^5.2.1",
    "graphql": "^16.11.0",
    "gsap": "^3.12.4",
    "intersection-observer": "^0.12.2",
    "keyboardevent-key-polyfill": "^1.1.0",
    "luxon": "^3.5.0",
    "mitt": "^3.0.1",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "punycode": "^2.1.1",
    "reka-ui": "^2.11.0",
    "resize-observer-polyfill": "^1.5.1",
    "smoothscroll-polyfill": "^0.4.4",
    "subscriptions-transport-ws": "^0.11.0",
    "vue": "latest",
    "vue-router": "5.5.0",
    "vue3-touch-events": "^5.0.15",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@rhapsodic/eslint-config": "^5.0.0",
    "@rhapsodic/stylelint-config": "^2.0.0",
    "@teages/nuxt-legacy": "^3.0.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.0.0",
    "@types/punycode": "^2.1.0",
    "@types/smoothscroll-polyfill": "^0.3.4",
    "@vitejs/plugin-legacy": "^8.2.4",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.6.2",
    "postcss-scss": "^4.0.9",
    "sass-embedded": "^1.106.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "terser": "^5.51.2",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^24.22.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module",
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit",
    "pre-commit": "pnpm exec lint-staged --concurrent false",
    "pre-push": "pnpm exec nuxt typecheck"
  },
  "lint-staged": {
    "*.{css,scss,vue}": "stylelint --allow-empty-input --cache --fix",
    "*.{js,cjs,mjs,ts,vue}": "eslint --cache --fix"
  }
}
