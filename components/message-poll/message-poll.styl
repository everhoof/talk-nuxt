.message-poll
	box-sizing border-box
	width 380px
	max-width 100%
	margin-top 8px
	padding 16px
	background var(--secondary-background)
	border 1px solid var(--primary)
	border-radius 8px

	&__caption
		font-size 12px
		color var(--accent-text)
		font-weight 600
		text-transform uppercase

	&__question
		margin 8px 0 16px
		font-size 16px
		line-height 1.4
		color var(--primary-text)
		overflow-wrap anywhere

	&__hint
		margin 12px 0 0
		font-size 12px
		line-height 1.5
		color var(--secondary-text)

	&__error
		margin 12px 0 0
		font-size 13px
		color var(--error)

	&__retry.button
		display block
		margin 8px 0 0

	&__action
		margin-top 12px
		margin-right 8px

	&__status
		margin 0 0 16px
		color var(--accent-text)
		font-size 13px
