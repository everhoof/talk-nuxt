.poll-multiple-choice

	&__choice
		display flex
		align-items flex-start
		gap 10px
		margin-top 8px
		padding 10px 12px
		color var(--primary-text)
		background var(--input-background)
		border-radius 5px
		overflow-wrap anywhere
		cursor pointer

		input
			flex-shrink 0
			width 16px
			height 16px
			margin 2px 0 0
			accent-color var(--primary)

	&__submit.button
		margin-top 12px
		margin-right 8px
		background-color var(--primary)
		border none
		outline none

		&:disabled
			background-color var(--input-background)
			opacity .45
			cursor not-allowed
