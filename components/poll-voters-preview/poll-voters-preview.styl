.poll-voters-preview
	display inline-flex
	align-items center
	padding 0
	color var(--secondary-text)
	cursor pointer
	background transparent
	border none
	border-radius 5px

	&:hover:not(:disabled)
		color var(--primary-text)

	&:focus
		outline 2px solid var(--primary)
		outline-offset 2px

	&:disabled
		cursor default
		opacity .6

	&__item
		display inline-flex
		margin-left -8px
		border 2px solid var(--secondary-background)
		border-radius 50%

		&:first-child
			margin-left 0

	&__more
		display inline-flex
		justify-content center
		align-items center
		min-width 24px
		height 24px
		padding 0 4px
		font-size 10px
		font-weight 600
		line-height 1
		background var(--input-background)
		border-radius 999px
		font-feature-settings 'tnum'
