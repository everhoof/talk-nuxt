@keyframes spin
	100%
		-moz-transform rotate(360deg)

@keyframes spin
	100%
		-webkit-transform rotate(360deg)

@keyframes spin
	100%
		transform rotate(360deg)
		-webkit-transform rotate(360deg)

.chat
	position relative
	display flex
	overflow hidden scroll
	flex-grow 1
	flex-direction column
	width 100%
	height 100%
	min-height 0

	&__message
		transition background-color .3s ease

		&_highlighted
			background var(--background-active)

	&__return
		position sticky
		bottom 12px
		flex-shrink 0
		margin-top -36px
		padding 8px 14px
		color var(--text-primary)
		font-size 12px
		cursor pointer
		background var(--background-secondary)
		border 1px solid var(--primary)
		border-radius 20px
		align-self center

	@-moz-document url-prefix()
		&
			background var(--background-primary)

	&__messages
		padding 0 0 10px

		&-loader
			position relative
			height 70px

			& .icon
				position absolute
				top 50%
				left 50%
				width 50px
				height 50px
				margin-top -25px
				margin-left -25px
				animation spin 4s linear infinite

				.page_theme_light &
					filter invert(1)

	&__loader
		position absolute
		top 0
		left 0
		width 100%
		height 100%

		& .icon
			position absolute
			top 50%
			left 50%
			width 50px
			height 50px
			margin-top -25px
			margin-left -25px
			animation spin 4s linear infinite

			.page_theme_light &
				filter invert(1)
