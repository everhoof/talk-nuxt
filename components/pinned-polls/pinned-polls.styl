.pinned-polls
	position relative
	z-index 1
	display flex
	align-items center
	flex-shrink 0
	min-width 0
	padding 6px 8px 6px 4px
	background var(--background-secondary)
	border-bottom 1px solid var(--border-input)

	@media (hover hover) and (pointer fine)
		&__arrow:hover
			background var(--background-hover)

	&__arrow:focus-visible
		outline 2px solid var(--primary)
		outline-offset -2px

	&__controls
		display flex
		align-items center
		flex-shrink 0
		margin-left 4px
		color var(--text-secondary)
		gap 4px

	&__counter
		flex-shrink 0
		min-width 7ch
		padding 0 4px
		font-size 12px
		text-align center
		white-space nowrap
		font-variant-numeric tabular-nums

	&__arrow
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		width 32px
		height 36px
		padding 6px
		color inherit
		cursor pointer
		background transparent
		border none
		border-radius 4px

		& svg
			width 20px
			height 20px
			stroke currentColor
			fill none
			stroke-linecap round
			stroke-linejoin round
			stroke-width 2
