.footer
	position relative
	display flex
	align-items flex-start
	flex-direction column
	min-height 52px
	padding 10px 12px
	box-shadow 0 -3px 6px var(--shadow)

	&__progress-bar
		position absolute
		top 3px
		right 12px
		left 12px

	&__emoji-panel
		position absolute
		left 12px
		bottom 100%
		overflow-y auto
		max-width 362px
		height 250px
		max-height 250px
		background var(--background-secondary)
		border-radius 5px
		box-shadow 0 0 6px rgba(0, 0, 0, .4)

	&__attach-panel
		position absolute
		left 0
		bottom 100%
		padding 12px 12px 0

	&__input-field
		position relative
		display flex
		align-items center
		width 100%
		min-height 32px
		padding 0 12px
		background-color var(--background-secondary)
		border-radius 5px
		box-shadow 0 0 6px var(--shadow)

	&__actions-left
		position relative
		display flex
		align-items center
		flex-shrink 0
		margin-right 12px

	&__actions-button
		display block
		width 24px
		height 24px
		fill var(--text-primary)
		cursor pointer

		&:hover
			fill var(--text-accent)

		&_type_active
			fill var(--text-accent)

		&:not(:last-child)
			margin-right 8px

	&__poll-button
		padding 0
		background transparent
		border none

		.icon
			width 24px
			height 24px

	&__emoji-button
		background-image url('~assets/emoji/faces.png')
		background-position -48px -24px
		background-size 264px 120px
		transform scale(.95)
		image-rendering -webkit-optimize-contrast
		filter grayscale(1)

		&^[0]__actions-button_type_active,
		&:hover
			filter grayscale(0)

		.page_theme_nightmare-night &
			position relative
			background-image none
			opacity .85
			filter none

			&:before
				content ''
				position absolute
				pointer-events none
				background url('/nightmare-night/emoji-pumpkin.svg') center / 24px 24px no-repeat
				inset 0

			&:hover,
			&.footer__actions-button_type_active
				opacity 1

	&__attach-button
		transform rotate(225deg)

		&^[0]__actions-button_type_active,
		&:hover
			fill var(--text-accent)

	&__input-container
		position relative
		display flex
		width 100%
		height 100%

	&__input
		flex-grow 1
		flex-basis 100%
		width 100%
		height 100%
		margin 0 6px 0 0
		color var(--text-primary)

	&__actions-right
		position relative
		display flex
		align-items center
		flex-shrink 0

	// TODO: Remove !important
	&__donate-button
		display none !important

		+above(size-m)
			display inline-block !important

	&__send-button
		position relative
		width 24px
		padding 0
		background transparent
		border none
		outline none

		& .icon
			transform rotate(45deg)

		+above(size-m)
			width 44px
			padding-left 20px

			&::before
				content ''
				position absolute
				top 50%
				left 10px
				width 1px
				height 20px
				background rgba(0, 0, 0, .1)
				transform translateY(-50%)

				.page_theme_dark &
					background rgba(255, 255, 255, .1)

	&__message-editor
		width 100%
		margin 0 0 10px
