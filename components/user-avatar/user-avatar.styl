.user-avatar
	display inline-flex
	overflow hidden
	justify-content center
	align-items center
	flex-shrink 0
	width var(--user-avatar__size, 35px)
	height var(--user-avatar__size, 35px)
	color var(--user-avatar__accent)
	font-weight 600
	background-color var(--secondary-background)
	background-image linear-gradient(var(--user-avatar__tint), var(--user-avatar__tint))
	border-radius 50%

	&__initials
		width 100%
		height 100%
		fill currentColor
		font-size 40px

	&__image
		width 100%
		height 100%
		object-fit cover

	&_size_tiny
		--user-avatar__size 24px
