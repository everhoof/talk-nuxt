.poll-result-item
	margin-bottom 12px

	&__label
		display flex
		justify-content space-between
		gap 12px
		margin-bottom 6px
		font-size 14px
		color var(--primary-text)
		overflow-wrap anywhere

		span:last-child
			flex-shrink 0

	&__bar
		height 6px
		background var(--input-background)
		border-radius 3px
		overflow hidden

	&__fill
		height 100%
		background var(--primary)
		transition width .2s
