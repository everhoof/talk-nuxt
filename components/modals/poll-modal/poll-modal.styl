.poll-modal
	display flex
	flex-direction column
	width 440px
	max-width 100%
	min-height 0
	max-height 65vh

	> * + *
		margin-top 16px

	&__body
		vertical-spacing(20px)
		overflow-y auto
		min-height 0
		// Keep outer focus rings inside the scrolling area without shifting the fields.
		margin -4px
		padding 4px

	&__field
		vertical-spacing(6px)

	&__label
		color var(--primary-text)
		font-size 14px
		font-weight 500
		line-height 16px

		span
			color var(--error)

	&__input
		box-sizing border-box
		width 100%
		min-width 0
		height 36px
		padding 10px 20px
		color var(--primary-text)
		font inherit
		font-size 14px
		line-height 16px
		background var(--input-background)
		border 1px solid var(--input-border)
		border-radius 5px

		&:focus
			outline 2px solid var(--primary)
			outline-offset 2px

		&:disabled
			opacity .5

	&__options,
	&__options-list
		vertical-spacing(8px)

	&__options-header
		display flex
		justify-content space-between
		align-items baseline
		horizontal-spacing(8px)

	&__count
		color var(--secondary-text)
		font-size 12px
		font-feature-settings 'tnum'

	&__option
		position relative
		display flex
		align-items center
		horizontal-spacing(6px)

		.poll-modal__input
			margin-left 0

	&__option-label
		position absolute
		overflow hidden
		clip rect(0, 0, 0, 0)
		width 1px
		height 1px
		white-space nowrap

	&__remove.button
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		width 32px
		height 32px
		padding 0
		color var(--secondary-text)
		background transparent
		border none
		border-radius 4px

		.icon
			width 16px
			height 16px
			fill currentColor

	&__hint,
	&__error
		margin 0
		color var(--secondary-text)
		font-size 13px
		line-height 1.4
		word-wrap break-word
		overflow-wrap break-word

	&__error
		color var(--error)

	&__settings
		vertical-spacing(8px)
		padding-top 12px
		border-top 1px solid var(--input-border)

	&__setting.switch
		margin 0
		color var(--primary-text)
		font-size 14px

		&:not(:first-child)
			margin-top 8px

		.switch__label
			min-height 24px
			padding-right 0
			padding-left 54px
			line-height 24px

			&:before
				width 46px
				height 24px

			&:after
				top 3px
				left 3px
				width 18px
				height 18px

		.switch__input:focus + .switch__label:before
			box-shadow 0 0 0 2px var(--primary-text)

		.switch__input:checked + .switch__label:after
			left 25px

	&__actions
		display flex
		justify-content flex-end
		flex-wrap wrap
		width 100%
		horizontal-spacing(8px)

		.poll-button
			flex-grow 0

	.poll-button .icon
		width 12px
		height 12px
		fill currentColor

	.poll-button.button
		min-height 32px
		line-height 16px
