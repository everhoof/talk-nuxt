.poll-modal
	box-sizing border-box
	width 440px
	max-width 100%
	max-height 65vh
	padding 4px
	overflow-y auto

	&__label
		display block
		margin-bottom 12px
		font-size 14px
		color var(--primary-text)

	&__input
		box-sizing border-box
		width 100%
		min-width 0
		padding 10px 12px
		color var(--primary-text)
		background var(--input-background)
		border 1px solid var(--input-border)
		border-radius 5px
		font inherit

		&:focus
			outline none
			border-color var(--primary)

	&__hint
		margin 12px 0 24px
		color var(--secondary-text)
		font-size 13px
		line-height 1.5

	&__option
		margin-bottom 16px

	&__option-input
		display flex
		align-items center
		gap 8px

	&__remove
		display flex
		align-items center
		justify-content center
		flex-shrink 0
		width 32px
		height 32px
		padding 6px
		background transparent
		border none
		fill var(--secondary-text)
		cursor pointer

		.icon
			width 20px
			height 20px

	&__error
		margin-top 12px
		color var(--error)
		font-size 14px

	&__submit
		margin-top 20px

	&__publish.button
		background-color var(--primary)
		border none
		outline none

		&:disabled
			background-color var(--secondary-background)
			opacity .45
			cursor not-allowed

	&__settings
		display flex
		flex-direction column
		gap 16px
		margin-top 24px

	&__setting
		margin 0
		font-size 14px
		color var(--primary-text)

		.switch__label
			line-height 1.5
			padding-right 0
